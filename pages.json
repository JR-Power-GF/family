{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^(.*)$": "@/components/$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/welcome/welcome",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "欢迎"
			}
		},
		{
			"path": "pages/index/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "温暖一大家",
				"navigationBarBackgroundColor": "#F8F8F8"
			}
		},
		{
			"path": "pages/add-story/add-story",
			"style": {
				"navigationBarTitleText": "发布故事"
			}
		},
		{
			"path": "pages/story-detail/story-detail",
			"style": {
				"navigationBarTitleText": "故事详情"
			}
		},
		{
			"path": "pages/profile/profile",
			"style": {
				"navigationBarTitleText": "个人主页"
			}
		},
		{
			"path": "pages/family/family",
			"style": {
				"navigationBarTitleText": "家庭成员"
			}
		},
		{
			"path": "pages/notifications/notifications",
			"style": {
				"navigationBarTitleText": "消息通知"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "温暖一大家",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"uniIdRouter": {}
}
